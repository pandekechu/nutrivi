<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mi Perfil y Metas"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre completo"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/et_profile_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ej: Asael Mora"
            android:inputType="textPersonName"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Peso actual (kg)"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/et_profile_weight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ej: 75.5"
            android:inputType="numberDecimal"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Meta diaria de Calorías (kcal)"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/et_goal_calories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ej: 2200"
            android:inputType="number"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Meta diaria de Agua (ml)"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/et_goal_water"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ej: 2500"
            android:inputType="number"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btn_save_profile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guardar Cambios"
            android:backgroundTint="@color/primary_mint"
            android:textColor="@color/surface_white" />

    </LinearLayout>
</ScrollView>tLayout>